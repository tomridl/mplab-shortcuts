{
  "name": "mplab-shortcuts",
  "displayName": "MPLAB Shortcuts",
  "description": "Some additional shortcuts for MPLAB extension",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomridl/mplab-shortcuts"
  },
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mplab-shortcuts",
          "title": "MPLAB Shortcuts",
          "icon": "$(tools)"
        }
      ]
    },
    "views": {
      "mplab-shortcuts": [
        {
          "type": "webview",
          "id": "mplab-shortcuts.shortcutsView",
          "name": "Shortcuts"
        }
      ]
    },
    "commands": [
      {
        "command": "mplab-shortcuts.build",
        "title": "MPLAB: Build"
      },
      {
        "command": "mplab-shortcuts.cleanBuild",
        "title": "MPLAB: Clean Build"
      },
      {
        "command": "mplab-shortcuts.exportHex",
        "title": "MPLAB: Export Hex"
      },
      {
        "command": "mplab-shortcuts.buildMerge",
        "title": "MPLAB: Build Linked + Merge (Unified Hex)"
      },
      {
        "command": "mplab-shortcuts.flashDevice",
        "title": "MPLAB: Flash Device"
      },
      {
        "command": "mplab-shortcuts.checkForUpdates",
        "title": "MPLAB: Check for Updates"
      },
      {
        "command": "mplab-shortcuts.listCommands",
        "title": "MPLAB: List Available Commands"
      }
    ],
    "configuration": {
      "title": "MPLAB Shortcuts",
      "properties": {
        "mplab-shortcuts.cmakePath": {
          "type": "string",
          "default": "",
          "description": "Path to the cmake executable. Leave empty to auto-detect (PATH, then /opt/homebrew/bin/cmake)."
        },
        "mplab-shortcuts.hexmatePath": {
          "type": "string",
          "default": "",
          "description": "Path to the XC8 hexmate executable. Leave empty to auto-detect the newest /Applications/microchip/xc8/v*/pic/bin/hexmate."
        },
        "mplab-shortcuts.autoUpdate.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check GitHub Releases for a newer version of this extension and prompt to install."
        },
        "mplab-shortcuts.autoUpdate.checkIntervalHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "How often (in hours) to check GitHub Releases for updates. Manual checks via 'MPLAB: Check for Updates' ignore this interval."
        },
        "mplab-shortcuts.autoUpdate.repository": {
          "type": "string",
          "default": "tomridl/mplab-shortcuts",
          "description": "GitHub repository (owner/name) to check for releases. Change this if you forked the extension."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
